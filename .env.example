# ============================================================
#  مدللني mdllni — متغيرات البيئة (Environment Variables)
#  حطّها في Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Supabase: Project Settings → API ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role secret  (سرّي جداً — لا تنشره ولا تحطه بالواجهة)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- توقيع الجلسات ---
# أي نص عشوائي طويل (32 حرفاً وفوق). للتوليد: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- حساب الإدارة (يُنشأ تلقائياً أول مرة يشتغل الـ API) ---
ADMIN_PHONE=07800000000
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=إدارة مدللني

# --- البريد (رمز التحقق OTP) — v8.0 | مطلوب لتفعيل الحسابات الجديدة ---
# اختر مزوداً واحداً: resend (الأسهل — 100 رسالة/يوم مجاناً) أو sendgrid أو brevo
MAIL_PROVIDER=resend
MAIL_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=مدللني <otp@yourdomain.com>
# ⚠️ للتطوير المحلي فقط — يطبع الرمز بالسجل بدل الإرسال. لا تضعه على Vercel أبداً:
# MAIL_DEV_ECHO=1

# --- Cloudflare Turnstile (اختياري — حماية من البوتات) — v8.0 ---
# مجاني: dash.cloudflare.com → Turnstile → Add site. بدونهما يُتخطى التحقق بهدوء.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...
