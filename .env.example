# ============================================================
#  مدللني mdllni — متغيرات البيئة (Environment Variables)
#  حطّها في Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Supabase: Project Settings → API ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role secret  (سرّي جداً — لا تنشره ولا تحطه بالواجهة)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- توقيع الجلسات ---
# أي نص عشوائي طويل (32 حرفاً وفوق). للتوليد: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- حساب الإدارة (يُنشأ تلقائياً أول مرة يشتغل الـ API) ---
ADMIN_PHONE=07800000000
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=إدارة مدللني

# --- رموز التحقق OTP (v9.0) — من Supabase نفسها، بلا أي مزود بريد خارجي ---
# ما يحتاج أي متغير هنا! فقط من لوحة Supabase:
#   Authentication → Sign In / Providers → Email = ON
#   ثم Authentication → Emails → قالب «Magic Link» لازم يعرض الرمز {{ .Token }}
#   (القالب الجاهز بالعربي موجود بـ README.md)
# لاحقاً عند كبر الاستخدام: SMTP مخصص من Authentication → SMTP Settings (دقيقتان).

# --- Cloudflare Turnstile (اختياري — حماية من البوتات) ---
# مجاني: dash.cloudflare.com → Turnstile → Add site.
# ⚠️ لازم المفتاحان معاً (العلني والسري) — نصف الضبط يُعتبر «غير مفعّل» بهدوء.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...
