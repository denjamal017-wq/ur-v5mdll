# ============================================================
#  أور UR — متغيرات البيئة (Environment Variables)
#  حطّها في Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Supabase: Project Settings → API ---
# Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role secret  (سرّي جداً — لا تنشره ولا تحطه بالفرونتايند)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- توقيع الجلسات ---
# أي نص عشوائي طويل (32 حرف وفوق). مثال للتوليد: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- حساب الإدارة (يُنشأ تلقائياً أول مرة يشتغل الـ API) ---
ADMIN_PHONE=07800000000
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=إدارة أور
