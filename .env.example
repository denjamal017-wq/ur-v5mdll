# مدللني mdllni — Vercel Environment Variables
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# مفضّل لطلبات Supabase Auth من السيرفر؛ إذا لم يوضع يُستخدم service_role داخل السيرفر فقط.
SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key
JWT_SECRET=replace-with-at-least-32-random-characters

ADMIN_PHONE=07838181890
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=إدارة مدللني
ADMIN_EMAIL=your-admin-email@example.com

# اختياري: لازم المفتاحان معاً
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# التحقق والبريد من Supabase Auth فقط — لا تضف MAIL_* ولا مزود بريد داخل الكود.
# Supabase Dashboard → Authentication → Providers → Email = ON
# Authentication → Email Templates → Magic Link:
#   رمز التحقق الخاص بك هو: {{ .Token }}
# Authentication → URL Configuration: ضع رابط الإنتاج الحقيقي، وليس localhost.
