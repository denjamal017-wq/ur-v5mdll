# مدللني mdllni v11 — Vercel Environment Variables
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# إلزامي لطلبات Supabase Auth؛ لا يُستعمل service_role لإرسال OTP.
SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PHONE=07838181890
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=إدارة مدللني
ADMIN_EMAIL=your-admin-email@example.com
# اختياري: origins خارج نفس الدومين مفصولة بفاصلة. اتركه فارغاً لمنع CORS الخارجي.
# APP_ORIGINS=https://mdllni.example
# اختياري: المفتاحان معاً أو لا تضع أياً منهما.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...
# Supabase Authentication → Providers → Email = ON
# Email Templates → Magic Link: رمز التحقق {{ .Token }}
# URL Configuration: رابط الإنتاج الحقيقي، وليس localhost.
# ممنوع: MAIL_PROVIDER / MAIL_API_KEY / MAIL_FROM / MAIL_DEV_ECHO
